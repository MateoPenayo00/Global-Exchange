# Facturación electrónica (Factura Segura, ambiente TEST). Sin token, las facturas
# se emiten en modo simulado. El token se obtiene con:
#   docker compose exec web python manage.py factura_segura_token --email <usuario ESI>
FACTURA_SEGURA_URL=https://apitest.facturasegura.com.py
FACTURA_SEGURA_TOKEN=
FACTURA_SEGURA_EMAIL=
# Datos del emisor y rango habilitado para el equipo 10 en TEST.
FACTURA_RUC=2595733
FACTURA_RUC_DV=3
FACTURA_ESTABLECIMIENTO=001
FACTURA_PUNTO_EXPEDICION=003
FACTURA_NUMERO_DESDE=314
FACTURA_NUMERO_HASTA=325
# Timbrado: completar si Factura Segura lo exige (no vino en la habilitación).
FACTURA_TIMBRADO=
FACTURA_TIMBRADO_INICIO=
