{
  "realm": "exchange-learning",
  "enabled": true,
  "registrationAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "clients": [
    {
      "clientId": "exchange-web",
      "name": "Exchange Pro Web App",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost/oidc/*"
      ],
      "webOrigins": [
        "http://localhost"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost/"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Standard customer role"
      },
      {
        "name": "admin",
        "description": "Administrative role"
      }
    ]
  },
  "users": [
    {
      "username": "demo.customer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Customer",
      "email": "demo.customer@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "ChangeMe123!",
          "temporary": false
        }
      ],
      "realmRoles": ["customer"]
    }
  ]
}
